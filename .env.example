# Website publik bisa berjalan tanpa database/storage. Kosongkan DATABASE_URI.
# Isi DATABASE_URI dan PAYLOAD_SECRET saat siap mengaktifkan CMS.
DATABASE_URI=
# CMS_ENABLED=false memaksa mode tanpa CMS meskipun DATABASE_URI terisi.
PAYLOAD_SECRET=<random-string-min-32-karakter: openssl rand -hex 32>
NEXT_PUBLIC_SITE_URL=https://www.p3ri.or.id
RESEND_API_KEY=<opsional di dev; wajib di production untuk notifikasi form>
NOTIFY_EMAIL=p3ri.indonesia@gmail.com
BLOB_READ_WRITE_TOKEN=<hanya production, Vercel Blob>
EMAIL_FROM=<alamat pengirim di domain yang sudah diverifikasi di Resend>
SEED_ADMIN_PASSWORD=<opsional; password admin awal yang dibuat pnpm seed>
GOOGLE_SITE_VERIFICATION=<opsional; kode verifikasi Google Search Console>
SECURITY_CONTACT=<opsional; email kontak keamanan untuk security.txt, default email sekretariat>
